# ============================================================
# 医院IT工单系统 — 环境变量示例（复制为 .env 填写真实值）
# 注意：.env 含敏感信息，切勿提交到 git（已在 .gitignore/.dockerignore）
# ============================================================

# ---- 安全 ----
# SECRET_KEY: 不设则从 /app/.secret 文件读取（首次自动生成并持久化）
# SECRET_KEY=

# 生产 HTTPS 下设为 1（cookie 仅 HTTPS 传输）；本地 HTTP 测试留空
SESSION_COOKIE_SECURE=1

# ---- 微信小程序 ----
# WECHAT_APPID=wx1234567890abcdef
# WECHAT_SECRET=your_wechat_secret
# WECHAT_TEMPLATE_ID=your_template_id

# ---- 企业微信机器人 ----
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ---- 日志（可选） ----
# LOG_LEVEL=INFO
# LOG_DIR=/app/logs
