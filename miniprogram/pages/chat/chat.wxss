.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 120rpx;
}

.loading-wrap {
  text-align: center;
  padding: 200rpx 0;
}
.loading-icon {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8ecf1;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  display: block;
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
}
.empty-icon { font-size: 96rpx; display: block; }
.empty-text { font-size: 30rpx; color: #64748b; margin-top: 20rpx; display: block; }
.empty-sub { font-size: 24rpx; color: #94a3b8; margin-top: 12rpx; display: block; }

.conv-list {
  padding: 0;
}

.conv-item {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  background: #fff;
  border-bottom: 2rpx solid #f1f5f9;
  transition: background .15s;
}
.conv-item:active { background: #f8fafc; }

/* ===== 头像容器 ===== */
.conv-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.conv-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  /* 毛玻璃立体感 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.10), 0 1rpx 3rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 1;
}

.conv-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  /* 图片自带一圈白边增加层次 */
  border: 2rpx solid rgba(255,255,255,0.6);
  box-sizing: border-box;
}

.conv-avatar-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.15);
  /* 让首字符略微下沉，视觉居中更好 */
  line-height: 1;
  margin-top: 2rpx;
}

/* ===== 群聊标记徽章 ===== */
.conv-group-badge {
  position: absolute;
  bottom: -2rpx;
  right: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.12);
}
.conv-group-icon {
  font-size: 18rpx;
  line-height: 1;
}

/* ===== 信息区域 ===== */
.conv-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.conv-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.conv-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.conv-time {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.conv-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conv-preview {
  font-size: 26rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.conv-sender {
  color: #64748b;
  font-weight: 500;
}

.badge-dot {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 浮动新聊按钮 */
.fab-new {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(79,70,229,0.4);
  z-index: 100;
}
.fab-new:active { transform: scale(0.92); box-shadow: 0 4rpx 16rpx rgba(79,70,229,0.35); }
.fab-new-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 200;
  line-height: 1;
}
