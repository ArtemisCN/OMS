.page { min-height: 100vh; background: #f5f6fa; }
.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background: linear-gradient(135deg, #4f46e5, #6366f1);
}
.header-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.btn-back { font-size: 28rpx; color: rgba(255,255,255,.8); padding: 8rpx; }
.loading { display: flex; justify-content: center; padding: 80rpx; }
.loading-text { color: #94a3b8; font-size: 28rpx; }
.content { padding: 24rpx; }

/* 气泡 tab 行 */
.stat-row {
  display: flex; gap: 16rpx; margin-bottom: 24rpx;
}
.stat-item {
  flex: 1; background: #fff; border-radius: 20rpx;
  padding: 24rpx 12rpx; text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.stat-num {
  display: block; font-size: 44rpx; font-weight: 800; color: #4f46e5;
}
.stat-label { font-size: 22rpx; color: #64748b; margin-top: 6rpx; }
.stat-item.active .stat-num { color: #4f46e5; }

/* 卡片 */
.card {
  background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.card-title { font-size: 28rpx; font-weight: 700; color: #1e293b; display: block; margin-bottom: 16rpx; }
.card-body { display: flex; flex-wrap: wrap; gap: 12rpx; }
.metric { flex: 1; min-width: 100rpx; text-align: center; }
.metric-val { display: block; font-size: 36rpx; font-weight: 800; color: #1e293b; }
.metric-label { font-size: 22rpx; color: #64748b; margin-top: 4rpx; }
.info-row { display: flex; align-items: center; padding: 12rpx 0; }
.info-label { font-size: 26rpx; color: #64748b; width: 100rpx; flex-shrink: 0; }
.info-val { font-size: 26rpx; color: #1e293b; font-weight: 500; }
.avatar-row { padding: 8rpx 0; display: flex; align-items: center; gap: 20rpx; }
.avatar-row:active { opacity: .7; }
.info-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 3rpx solid #e8ecf1;
  flex-shrink: 0;
}
.info-avatar-hint { font-size: 24rpx; color: #4f46e5; margin-left: auto; }
