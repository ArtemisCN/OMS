<view class="page">
  <view class="header">
    <view class="header-left">
      <text class="header-title">📅 值班排班表</text>
    </view>
    <text class="btn-back" bindtap="onGoBack">‹ 返回</text>
  </view>

  <!-- 月份切换气泡 -->
  <view class="month-bar">
    <text class="month-arrow" bindtap="onPrevMonth">‹</text>
    <view class="month-info">
      <text class="month-text">{{year}}年{{month}}月</text>
      <text class="btn-today" bindtap="onGoToday">📅 今天</text>
      <text class="today-desc" wx:if="{{todayDuty.length > 0}}">今日值班：<text wx:for="{{todayDuty}}" wx:key="*this">{{item.person_name}} </text></text>
    </view>
    <text class="month-arrow" bindtap="onNextMonth">›</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="content">
    <!-- 日历表头 -->
    <view class="cal-header">
      <text class="cal-hd-name">姓名</text>
      <scroll-view class="cal-hd-days" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollToHd}}">
        <view class="cal-day-row">
          <view id="{{d.isToday ? 'hd-today' : ''}}" class="cal-hd-cell {{d.isToday ? 'today' : ''}} {{d.isWeekend ? 'weekend' : ''}}" wx:for="{{days}}" wx:key="day">
            <text class="cal-hd-dow">{{d.dowLabel}}</text>
            <text class="cal-hd-day">{{d.md}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 值班人员行 -->
    <scroll-view class="cal-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="cal-row" wx:for="{{staff}}" wx:key="*this" wx:for-item="s">
        <text class="cal-name">{{s}}</text>
        <scroll-view class="cal-cells" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="cal-cell-row">
            <view class="cal-cell {{records[s+'_'+d.day] ? 'has-shift' : ''}} {{d.isToday ? 'today' : ''}} {{d.isWeekend ? 'weekend' : ''}}" wx:for="{{days}}" wx:key="day" wx:for-item="d">
              <text class="cal-cell-txt">{{records[s+'_'+d.day] || ''}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{staff.length === 0}}" class="empty">暂无排班数据</view>
    </scroll-view>
  </view>
</view>
