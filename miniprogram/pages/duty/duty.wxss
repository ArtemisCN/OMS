.page { min-height: 100vh; background: #f5f6fa; display: flex; flex-direction: column; }
.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background: linear-gradient(135deg, #4f46e5, #6366f1);
  flex-shrink: 0;
}
.header-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.btn-back { font-size: 28rpx; color: rgba(255,255,255,.8); padding: 8rpx; }

/* 月份切换 */
.month-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background: #fff;
  border-bottom: 2rpx solid #f1f5f9; flex-shrink: 0;
}
.month-info { text-align: center; flex: 1; }
.month-text { font-size: 30rpx; font-weight: 700; color: #1e293b; display: block; }
.today-desc { font-size: 22rpx; color: #4f46e5; margin-top: 4rpx; display: block; }
.btn-today { font-size: 20rpx; color: #4f46e5; background: #eef2ff; padding: 2rpx 14rpx; border-radius: 20rpx; margin-top: 6rpx; display: inline-block; }
.month-arrow { font-size: 36rpx; color: #4f46e5; padding: 8rpx 20rpx; font-weight: 700; }

.loading { display: flex; justify-content: center; padding: 80rpx; }
.loading-text { color: #94a3b8; font-size: 28rpx; }
.content { flex: 1; overflow: hidden; display: flex; flex-direction: column; }

/* 日历表头 */
.cal-header { display: flex; background: #fff; flex-shrink: 0; }
.cal-hd-name {
  width: 120rpx; font-size: 22rpx; font-weight: 700; color: #64748b;
  text-align: center; padding: 12rpx 0; flex-shrink: 0;
  border-right: 2rpx solid #f1f5f9;
}
.cal-hd-days { flex: 1; }
.cal-day-row { display: flex; }
.cal-hd-cell {
  width: 72rpx; text-align: center; padding: 8rpx 0; flex-shrink: 0;
}
.cal-hd-cell.today { 
  background: transparent; 
  border-radius: 0;
  position: relative;
}
.cal-hd-cell.today::after {
  content: '';
  position: absolute;
  top: 4rpx; left: 4rpx; right: 4rpx; bottom: 4rpx;
  border: 4rpx solid #4f46e5;
  border-radius: 12rpx;
  pointer-events: none;
}
.empty { text-align: center; padding: 60rpx; color: #94a3b8; font-size: 28rpx; }
.cal-hd-cell.today .cal-hd-day {
  color: #4f46e5;
  font-weight: 800;
}
.cal-hd-dow { display: block; font-size: 20rpx; color: #94a3b8; font-weight: 500; line-height: 1.3; }
.cal-hd-day { display: block; font-size: 22rpx; font-weight: 700; color: #1e293b; line-height: 1.3; }
.cal-hd-cell.weekend .cal-hd-dow { color: #ef4444; }
.cal-hd-cell.weekend .cal-hd-day { color: #0f172a; }

/* 日历体 */
.cal-body { flex: 1; overflow-y: auto; background: #fff; }
.cal-row { display: flex; border-bottom: 2rpx solid #f8fafc; }
.cal-name {
  width: 120rpx; font-size: 22rpx; color: #1e293b; font-weight: 600;
  text-align: center; padding: 16rpx 0; flex-shrink: 0;
  border-right: 2rpx solid #f1f5f9;
}
.cal-cells { flex: 1; }
.cal-cell-row { display: flex; }
.cal-cell {
  width: 72rpx; height: 56rpx; flex-shrink: 0; display: flex;
  align-items: center; justify-content: center;
}
.cal-cell.has-shift .cal-cell-txt {
  font-size: 20rpx; color: #fff; background: #4f46e5;
  padding: 2rpx 6rpx; border-radius: 8rpx; font-weight: 600;
}
.cal-cell-txt { font-size: 18rpx; color: #94a3b8; }
.cal-cell.weekend { background: #fafafa; }
.cal-cell.today { 
  background: transparent;
  position: relative;
}
.cal-cell.today::after {
  content: '';
  position: absolute;
  top: 2rpx; left: 2rpx; right: 2rpx; bottom: 2rpx;
  border: 3rpx solid #4f46e5;
  border-radius: 10rpx;
  pointer-events: none;
}
.empty { text-align: center; padding: 60rpx; color: #94a3b8; font-size: 28rpx; }
