.page { min-height: 100vh; background: #f5f6fa; display: flex; flex-direction: column; }
.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background: linear-gradient(135deg, #4f46e5, #6366f1);
  flex-shrink: 0;
}
.header-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.btn-back { font-size: 28rpx; color: rgba(255,255,255,.8); padding: 8rpx; }

/* tab */
.tab-bar {
  display: flex; background: #fff; padding: 0; flex-shrink: 0;
  border-bottom: 2rpx solid #f1f5f9;
}
.tab-item {
  flex: 1; text-align: center; padding: 24rpx 0; position: relative;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
}
.tab-item.active { color: #4f46e5; font-weight: 700; }
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 20%; right: 20%;
  height: 4rpx; background: #4f46e5; border-radius: 4rpx 4rpx 0 0;
}
.tab-icon { font-size: 28rpx; }
.tab-label { font-size: 28rpx; color: #64748b; }
.tab-item.active .tab-label { color: #4f46e5; }
.tab-badge {
  background: #ef4444; color: #fff; font-size: 20rpx; font-weight: 700;
  min-width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center;
  border-radius: 16rpx; padding: 0 8rpx; margin-left: 4rpx;
}

.content { flex: 1; overflow-y: auto; padding: 20rpx 24rpx; padding-bottom: 40rpx; }

/* card */
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-title { font-size: 28rpx; font-weight: 700; color: #1e293b; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 2rpx solid #f1f5f9; }

/* form */
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: #64748b; margin-bottom: 8rpx; }
.form-static {
  display: flex; align-items: center;
  background: #f1f5f9; border-radius: 12rpx; padding: 20rpx 16rpx;
}
.form-static-txt { font-size: 28rpx; color: #1e293b; font-weight: 600; }
.form-picker {
  display: flex; align-items: center; justify-content: space-between;
  background: #f8fafc; border-radius: 12rpx; padding: 20rpx 16rpx;
}
.picker-txt { font-size: 28rpx; color: #1e293b; }
.picker-arrow { font-size: 28rpx; color: #94a3b8; }
.form-textarea {
  width: 100%; min-height: 120rpx; background: #f8fafc;
  border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; color: #1e293b;
  box-sizing: border-box;
}

/* 工单选择按钮 */
.order-pick-btn {
  display: flex; align-items: center; gap: 8rpx;
  background: #f8fafc; border-radius: 12rpx; padding: 20rpx 16rpx;
  border: 2rpx dashed #d1d5db;
}
.order-pick-icon { font-size: 28rpx; }
.order-pick-txt { flex: 1; font-size: 26rpx; color: #64748b; }
.order-pick-arrow { font-size: 28rpx; color: #94a3b8; }
.selected-order-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.order-tag {
  background: #eef2ff; color: #4f46e5; font-size: 22rpx; padding: 4rpx 14rpx;
  border-radius: 20rpx; font-weight: 600;
}

/* photo */
.photo-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.photo-item { position: relative; width: 160rpx; height: 160rpx; }
.photo-img { width: 100%; height: 100%; border-radius: 12rpx; object-fit: cover; }
.photo-del {
  position: absolute; top: -8rpx; right: -8rpx;
  background: #ef4444; color: #fff; width: 32rpx; height: 32rpx; line-height: 32rpx;
  text-align: center; border-radius: 50%; font-size: 20rpx;
}
.photo-add {
  width: 160rpx; height: 160rpx; border: 2rpx dashed #d1d5db; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.photo-add-icon { font-size: 40rpx; color: #94a3b8; }
.photo-add-txt { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }

/* btn */
.btn-primary {
  width: 100%; background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff; border-radius: 44rpx; padding: 24rpx; text-align: center;
  font-size: 30rpx; font-weight: 600; border: none;
}
.btn-primary[disabled] { opacity: .5; }

/* handover list */
.handover-list { padding: 0; }
.handover-item {
  background: #fff; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 16rpx;
}
.handover-top { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.handover-person { font-size: 26rpx; font-weight: 600; color: #1e293b; }
.handover-arrow { font-size: 22rpx; color: #94a3b8; }
.handover-time { font-size: 22rpx; color: #94a3b8; margin-left: auto; }
.handover-content { display: block; font-size: 26rpx; color: #475569; margin-top: 12rpx; line-height: 1.5; }
.handover-notes { display: block; font-size: 24rpx; color: #64748b; margin-top: 8rpx; }

/* 关联工单 */
.h-orders { margin-top: 12rpx; display: flex; flex-direction: column; gap: 8rpx; }
.h-order-item {
  display: flex; align-items: center; gap: 8rpx;
  background: #f8fafc; border-radius: 10rpx; padding: 12rpx 14rpx;
  border-left: 6rpx solid #4f46e5;
}
.h-order-icon { font-size: 24rpx; }
.h-order-title { flex: 1; font-size: 26rpx; color: #1e293b; font-weight: 500; }
.h-order-status { font-size: 24rpx; }

/* photo scroll */
.h-photo-scroll { margin-top: 12rpx; white-space: nowrap; }
.h-photo {
  width: 140rpx; height: 140rpx; border-radius: 10rpx; margin-right: 10rpx;
  object-fit: cover; display: inline-block;
}

.load-more { text-align: center; padding: 24rpx; color: #4f46e5; font-size: 26rpx; }
.loading { text-align: center; padding: 80rpx; }
.loading-text { color: #94a3b8; font-size: 28rpx; }
.empty { text-align: center; padding: 80rpx; color: #94a3b8; font-size: 28rpx; }

/* ===== 工单选择弹窗 ===== */
.order-picker-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.4); z-index: 100;
  display: flex; align-items: flex-end;
}
.order-picker {
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  width: 100%; max-height: 70vh; display: flex; flex-direction: column;
}
.order-picker-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx 16rpx; border-bottom: 2rpx solid #f1f5f9;
  flex-shrink: 0;
}
.order-picker-title { font-size: 30rpx; font-weight: 700; color: #1e293b; }
.order-picker-close { font-size: 28rpx; color: #4f46e5; font-weight: 700; padding: 8rpx 16rpx; }
.order-picker-list { flex: 1; overflow-y: auto; padding: 12rpx 0; }
.order-picker-empty { text-align: center; padding: 60rpx; color: #94a3b8; font-size: 26rpx; }
.order-picker-item {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 18rpx 24rpx; border-bottom: 2rpx solid #f8fafc;
}
.order-picker-item.checked { background: #f5f3ff; }
.order-checkbox { padding-top: 4rpx; }
.checkbox-on {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #4f46e5; color: #fff; text-align: center; line-height: 36rpx;
  font-size: 20rpx; font-weight: 700;
}
.checkbox-off {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid #d1d5db; box-sizing: border-box;
}
.order-info { flex: 1; min-width: 0; }
.order-title { font-size: 26rpx; font-weight: 600; color: #1e293b; display: block; }
.order-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; }
.order-status-tag {
  font-size: 20rpx; color: #4f46e5; background: #eef2ff;
  padding: 2rpx 12rpx; border-radius: 16rpx;
}
.order-location { font-size: 22rpx; color: #94a3b8; }
.order-date { font-size: 22rpx; color: #94a3b8; margin-left: auto; }
