# ============================================================
# 医院IT工单系统 — 环境变量示例
# 复制为 .env 并填写真实值（.env 已在 .gitignore/.dockerignore 排除，勿提交）
# ============================================================

# ---- 安全 ----
# SECRET_KEY: 会话签名密钥（生产必须设置强随机值；不设则从 .secret 文件读取）
SECRET_KEY=your-secret-key-here

# ---- 微信小程序 ----
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
WECHAT_TEMPLATE_ID=your-wechat-template-id

# ---- 企业微信机器人 ----
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ---- 数据库 ----
# 当前版本固定使用 SQLite（instance/workorders.db，config.py 硬编码）；
# 如需切换 MySQL/PostgreSQL 需同步改 config.py，此变量为预留占位
# DATABASE_URL=sqlite:///instance/workorders.db

# ---- 日志 ----
LOG_LEVEL=INFO
# LOG_DIR=/app/logs

# ---- Session ----
# 生产 HTTPS 下设为 1（cookie 仅 HTTPS 传输）；本地 HTTP 测试留空
SESSION_COOKIE_SECURE=1
