.page {
  min-height: 100vh;
  background: #f5f6fa;
}

.loading-wrap {
  text-align: center;
  padding: 200rpx 0;
}
.loading-icon {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8ecf1;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  display: block;
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 16rpx;
}

/* 模式切换栏 */
.mode-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  position: sticky;
  top: 0;
  z-index: 10;
}
.mode-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 4rpx;
}
.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  transition: all 0.2s;
}
.mode-tab.active {
  background: #fff;
  color: #4f46e5;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.mode-tab-icon {
  font-size: 28rpx;
}

/* 群聊已选栏 */
.group-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #eef2ff;
  border-bottom: 2rpx solid #e0e7ff;
}
.group-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}
.group-tag {
  display: inline-block;
  background: #4f46e5;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 10rpx;
}
.group-count {
  font-size: 22rpx;
  color: #4f46e5;
  white-space: nowrap;
  font-weight: 500;
}
.group-btn {
  background: #4f46e5;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  white-space: nowrap;
  font-weight: 600;
}
.group-btn:active { opacity: 0.8; }

/* 用户列表 */
.user-scroll {
  padding: 0 24rpx 40rpx;
}

.team-group {
  margin-top: 28rpx;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 12rpx;
}
.team-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}
.team-count {
  font-size: 22rpx;
  color: #94a3b8;
}

.team-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.user-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
}
.user-item:last-child { border-bottom: none; }
.user-item:active { background: #f8fafc; }
.user-item.checked { background: #eef2ff; }

.user-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  transition: all 0.2s;
}
.user-checkbox.checked {
  background: #4f46e5;
  border-color: #4f46e5;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #0f172a;
  display: block;
}
.user-hospital {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  display: block;
}

.btn-start {
  font-size: 24rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.btn-start:active { opacity: 0.7; }
