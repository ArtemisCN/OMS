.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}

/* ===== 消息滚动区 ===== */
.msg-scroll {
  flex: 1;
  padding: 0 20rpx;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

.load-more-hint {
  text-align: center;
  padding: 20rpx 0;
  font-size: 22rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.loading-mini {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #e8ecf1;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  display: inline-block;
}
@keyframes spin { to { transform: rotate(360deg); } }

.empty-chat {
  text-align: center;
  padding: 200rpx 0;
}
.empty-chat-icon { font-size: 80rpx; display: block; }
.empty-chat-text { font-size: 26rpx; color: #94a3b8; margin-top: 16rpx; display: block; }

/* ===== 消息项 ===== */
.msg-item {
  margin-bottom: 32rpx;
}

.time-sep {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin: 48rpx 0 24rpx;
  position: relative;
}
.time-sep::before,
.time-sep::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 40rpx;
  height: 2rpx;
  background: #e8ecf1;
}
.time-sep::before { left: 20%; }
.time-sep::after { right: 20%; }

.recalled-msg {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  font-style: italic;
  padding: 8rpx 0;
}

/* ===== 消息行（头像 + 内容） ===== */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  max-width: 88%;
}

.msg-item.self .msg-row {
  flex-direction: row-reverse;
  margin-left: auto;
}

.msg-item.other .msg-row {
  flex-direction: row;
  margin-right: auto;
}

/* ===== 头像 ===== */
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.msg-avatar-self {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
}
.msg-avatar-other {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
}
.msg-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

/* ===== 内容区 ===== */
.msg-content {
  min-width: 0;
  max-width: 100%;
}

.msg-name {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
  padding-left: 4rpx;
}

.msg-item.self .msg-name {
  text-align: right;
  padding-right: 4rpx;
}

/* ===== 气泡 ===== */
.msg-bubble {
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  word-break: break-word;
  position: relative;
  line-height: 1.5;
}

.msg-item.self .msg-bubble {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-item.other .msg-bubble {
  background: #fff;
  color: #1e293b;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-image {
  max-width: 360rpx;
  max-height: 440rpx;
  border-radius: 14rpx;
  display: block;
}

.msg-file {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
}
.file-icon { font-size: 36rpx; }
.file-name { color: #4f46e5; text-decoration: underline; }

/* ===== 输入栏 ===== */
.input-bar {
  background: #fff;
  border-top: 2rpx solid #e8ecf1;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 44rpx;
  padding: 0 6rpx 0 24rpx;
}

.msg-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  background: transparent;
  color: #0f172a;
}

.input-placeholder {
  color: #94a3b8;
  font-size: 28rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn:active { opacity: 0.6; }
.action-btn-icon { font-size: 32rpx; }

.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8ecf1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s;
}
.send-btn.active {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
}
.send-btn:active { opacity: 0.8; }
.send-icon {
  font-size: 28rpx;
  color: #94a3b8;
}
.send-btn.active .send-icon {
  color: #fff;
}
