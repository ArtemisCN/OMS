.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 40rpx;
}

.banner {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  padding: 40rpx 32rpx;
  text-align: center;
}
.banner-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}
.banner-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
  display: block;
}

.current-section {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 20rpx;
}
.current-avatar-wrap {
  display: inline-block;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(79,70,229,0.25);
}
.current-avatar {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.avatar-section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.avatar-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: all .2s;
}
.avatar-item:active {
  transform: scale(0.92);
}
.avatar-item.selected {
  border-color: #4f46e5;
  box-shadow: 0 0 0 4rpx rgba(79,70,229,0.2);
}
.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.avatar-check {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: #4f46e5;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}
